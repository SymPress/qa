{
    "name": "sympress/qa",
    "description": "Shared QA tooling for SymPress packages.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Brian Schaffner",
            "email": "brian.schaeffner@sympress.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^13.0",
        "symfony/console": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/process": "^8.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "sympress/coding-standards": "^1.1.1"
    },
    "autoload": {
        "psr-4": {
            "SymPress\\Qa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymPress\\Qa\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/qa"
    ],
    "scripts": {
        "lint:php": "@php bin/qa lint:php",
        "cs": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/qa cs --strict"
        ],
        "cs:fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/qa cs:fix"
        ],
        "static-analysis": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/qa static-analysis --strict"
        ],
        "tests": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/qa tests --strict"
        ],
        "test": [
            "@tests"
        ],
        "qa": [
            "@php bin/qa doctor --strict",
            "@lint:php",
            "@cs",
            "@static-analysis",
            "@tests"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
