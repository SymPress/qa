<?xml version="1.0"?>
<ruleset name="SymPress QA">
    <description>
        Coding standard audit for the shared SymPress QA runner package.
    </description>

    <arg name="colors" />
    <arg value="sp" />
    <arg name="basepath" value="." />

    <config name="testVersion" value="8.5-" />

    <file>bin/qa</file>
    <file>src</file>
    <file>tests</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>.phpunit.cache/*</exclude-pattern>

    <rule ref="SymPress-Pure">
        <exclude name="SlevomatCodingStandard.Functions.UnusedParameter.UnusedParameter" />
        <exclude name="SymPress.Classes.AccessorNaming.GetterRequired" />
        <exclude name="SymPress.Files.LineLength.TooLong" />
        <exclude name="SymPress.Functions.FunctionLength.TooLong" />
        <exclude name="SymPress.Functions.ReturnTypeDeclaration.NoReturnType" />
    </rule>

    <rule ref="SymPress.Namespaces.Psr4">
        <properties>
            <property name="psr4" type="array">
                <element key="SymPress\Qa" value="src" />
                <element key="SymPress\Qa\Tests" value="tests" />
            </property>
        </properties>
    </rule>
</ruleset>
